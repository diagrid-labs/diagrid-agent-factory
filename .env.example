# The repository the agents watch, and open PRs on.
TARGET_REPO=diagrid-labs/diagrid-agent-factory
# The only directory the implementer may change, and how to test it.
TARGET_SCOPE=sample-app
TEST_COMMAND=python -m pytest -q sample-app

# GitHub token with issues, pull requests and contents write on TARGET_REPO.
# Leave empty to use your `gh auth login`.
GITHUB_TOKEN=

# Ask a person (/approve on the issue) before the PR is opened.
REQUIRE_APPROVAL=true
APPROVAL_TIMEOUT_HOURS=24
MAX_REVIEW_ROUNDS=2
POLL_SECONDS=30
# Start work on every new issue opened by an owner, member or collaborator,
# without waiting for the agent:implement label.
AUTO_PICKUP=false

# How the agents think:
#   claude        the Claude Agent SDK, using this machine's Claude login
#                 (or CLAUDE_CODE_OAUTH_TOKEN / ANTHROPIC_API_KEY)
#   conversation  any LLM behind a Dapr Conversation component (LLM_COMPONENT)
AGENT_BACKEND=claude
CLAUDE_MODEL=claude-sonnet-5-5

# Diagrid component names.
LLM_COMPONENT=llm-provider
STATE_STORE=kvstore
