# The repository the agents watch, and open PRs on.
TARGET_REPO=diagrid-labs/catalyst-agent-factory
# The only directory the implementer may change, and how to test it.
TARGET_SCOPE=sample-app
TEST_COMMAND=python -m pytest -q sample-app

# GitHub token with issues, pull requests and contents write on TARGET_REPO.
# Leave empty to use your `gh auth login`.
GITHUB_TOKEN=

# Ask a person (/approve on the issue) before the PR is opened.
REQUIRE_APPROVAL=true
APPROVAL_TIMEOUT_HOURS=24
MAX_REVIEW_ROUNDS=2
POLL_SECONDS=30

# Catalyst component names.
LLM_COMPONENT=llm-provider
STATE_STORE=kvstore
